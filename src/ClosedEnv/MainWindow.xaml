<Window x:Class="ClosedEnv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClosedEnv"
        Height="640" Width="920"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="ClosedEnv" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                   Text="Безопасный режим для недоверенных Windows-программ"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="ThemeToggleButton" Style="{StaticResource GhostButton}"
                Content="Светлая" Click="ThemeToggle_Click" Margin="0,0,8,0"/>
        <Button x:Name="EnableSandboxButton" Style="{StaticResource GhostButton}"
                Content="Включить Sandbox" Click="EnableSandbox_Click"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Text="{Binding DisplayKind}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="22"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock x:Name="ProfileTitle" FontSize="22" FontWeight="SemiBold" Text="Профиль"/>
            <TextBlock x:Name="ProfileDescription" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
              <TextBlock x:Name="HonestyNote" Style="{StaticResource MutedText}" FontSize="12"
                         Text="MAX остаётся обычным мессенджером и ходит в свою сеть. Изоляция закрывает файлы и устройства этого компьютера."/>
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,18,0,12">
            <TextBlock Text="Переключатели сессии" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <CheckBox x:Name="ClipboardToggle" Content="Буфер обмена хоста"/>
            <CheckBox x:Name="AudioToggle" Content="Микрофон"/>
            <CheckBox x:Name="CameraToggle" Content="Камера"/>
            <CheckBox x:Name="FirewallToggle" Content="Гостевой файрвол (только домены профиля)"/>

            <StackPanel x:Name="SandboxLogPanel" Margin="0,16,0,0" Visibility="Collapsed">
              <TextBlock Text="Журнал песочницы" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8"
                         Text="Без расшифровки TLS: время, действие, домен или URL из гостевого лога."/>
              <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Content="Открыть лог"
                      Click="OpenGuestLog_Click"/>
            </StackPanel>

            <StackPanel x:Name="PayloadPanel" Margin="0,16,0,0" Visibility="Collapsed">
              <TextBlock Text="Файл для песочницы" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Обзор"
                        Click="BrowsePayload_Click" Margin="8,0,0,0"/>
                <TextBlock x:Name="PayloadPathText" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           Text="Файл не выбран. Он будет скопирован в каталог профиля."/>
              </DockPanel>
            </StackPanel>
          </StackPanel>

          <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Запустить"
                    MinWidth="160" Click="Launch_Click"/>
            <TextBlock x:Name="DataPathText" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                       FontSize="12"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,16,0,0" FontSize="13"/>
  </Grid>
</Window>
