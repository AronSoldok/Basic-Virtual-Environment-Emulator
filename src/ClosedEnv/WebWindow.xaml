<Window x:Class="ClosedEnv.WebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ClosedEnv — MAX Web"
        Height="880" Width="1180"
        MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterOwner">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="160"/>
    </Grid.RowDefinitions>

    <Border Padding="12,10" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button x:Name="ToggleLogButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                Content="Скрыть журнал" Click="ToggleLog_Click" Margin="12,0,0,0"/>
        <Button x:Name="ThemeToggleButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                Content="Светлая" Click="ThemeToggle_Click" Margin="12,0,0,0"/>
        <ComboBox x:Name="LogDock" DockPanel.Dock="Right" Width="128" Margin="12,0,0,0"
                  ToolTip="Положение журнала" SelectionChanged="DockChanged">
          <ComboBoxItem Content="снизу" Tag="bottom" IsSelected="True"/>
          <ComboBoxItem Content="сверху" Tag="top"/>
          <ComboBoxItem Content="справа" Tag="right"/>
        </ComboBox>
        <TextBlock x:Name="FilterStatus" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="12"
                   VerticalAlignment="Center" Text="фильтр доменов включён"/>
        <TextBlock Text="Изолированная сессия web.max.ru" FontWeight="SemiBold"/>
      </DockPanel>
    </Border>

    <Grid x:Name="WorkArea" Grid.Row="1">
      <wv2:WebView2 x:Name="Browser"/>
      <GridSplitter x:Name="LogSplitter" Height="6" HorizontalAlignment="Stretch"
                    Background="{DynamicResource BorderBrush}" ResizeDirection="Rows"/>
      <Border x:Name="LogPanel" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
              PreviewMouseWheel="LogPanel_OnPreviewMouseWheel">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="120"/>
          </Grid.RowDefinitions>

          <Grid Margin="10,8,10,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Фильтр" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="KindFilter" Grid.Column="1" SelectionChanged="FilterChanged">
              <ComboBoxItem Content="Все" Tag="all" IsSelected="True"/>
              <ComboBoxItem Content="Пропущенные" Tag="allow"/>
              <ComboBoxItem Content="Отрезанные" Tag="block"/>
            </ComboBox>
            <TextBox x:Name="SearchBox" Grid.Column="3" TextChanged="SearchChanged"
                     ToolTip="Поиск по URL, хосту, методу, телу"/>
            <TextBlock x:Name="CountText" Grid.Column="5" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <Button Grid.Column="7" Style="{StaticResource GhostButton}" Content="Очистить" Click="ClearLog_Click"/>
            <Button Grid.Column="9" Style="{StaticResource GhostButton}" Content="Файл лога" Click="OpenLogFile_Click"/>
          </Grid>

          <ListView x:Name="LogList" Grid.Row="1" Margin="10,0,10,6"
                    SelectionChanged="LogList_OnSelectionChanged">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Время" Width="96" DisplayMemberBinding="{Binding TimeText}"/>
                <GridViewColumn Header="Метод" Width="72" DisplayMemberBinding="{Binding Method}"/>
                <GridViewColumn Header="Статус" Width="92" DisplayMemberBinding="{Binding StatusText}"/>
                <GridViewColumn Header="Хост" Width="180" DisplayMemberBinding="{Binding Host}"/>
                <GridViewColumn Header="URL" Width="520" DisplayMemberBinding="{Binding ShortUrl}"/>
              </GridView>
            </ListView.View>
          </ListView>

          <TextBox x:Name="DetailBox" Grid.Row="2" Margin="10,0,10,10" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" FontFamily="Consolas"
                   Text="Кликните запись. WebSocket-кадры после рукопожатия WebView обычно не показывает."/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
